PORT=5000

# Prodigy AI — Users tab + main /login admins
MONGODB_URI=mongodb+srv://...

# Access Control — organizations, access_users, counselors, referral codes, access students
# (also accepted as MONGODB_URI_ADMIN)
MONGODB_ADMIN=mongodb+srv://...

# Career Beacon database (Users tab)
MONGODB_URI_CAREER_BEACON=mongodb+srv://...

# Vidhyasaarthi platform users (Users tab). Same as website MONGO_URI.
# Referral codes are NOT here — they live in MONGODB_ADMIN.
MONGODB_URI_VIDHYASAARTHI=mongodb+srv://...

JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Required in production / Vercel. Must match Vidhyasaarthi INTERNAL_REGISTER_KEY.
INTERNAL_REGISTER_KEY=replace_with_a_long_random_shared_secret

# Admin-owned default org for students with no / invalid referral (from seed:vidhyasaarthi)
DEFAULT_ORGANIZATION_ID=
DEFAULT_ORG_NAME=Vidhyasaarthi

# Optional overrides for seed:super-admin
# SUPER_ADMIN_EMAIL=superadmin@guidopia.com
# SUPER_ADMIN_PASSWORD=SuperAdmin@123
# SUPER_ADMIN_NAME=Guidopia Super Admin
