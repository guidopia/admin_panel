PORT=5000
MONGODB_URI=mongodb+srv://...
# Career Beacon database (enables Career Beacon tab on Users page)
MONGODB_URI_CAREER_BEACON=mongodb+srv://...
# Vidhyasaarthi / student website database (enables Vidhyasaarthi tab on Users page)
# Paste the same URI as the website backend MONGO_URI.
MONGODB_URI_VIDHYASAARTHI=mongodb+srv://...
JWT_SECRET=replace_with_a_long_random_secret
JWT_EXPIRES_IN=7d
CORS_ORIGIN=http://localhost:5173

# Optional: lock POST /api/access/students/register to the student website
# server-to-server calls. When set, callers must send a matching
# `x-internal-key` header. Must equal the student website's INTERNAL_REGISTER_KEY.
# INTERNAL_REGISTER_KEY=replace_with_a_long_random_shared_secret

# Optional overrides for seed:super-admin
# SUPER_ADMIN_EMAIL=superadmin@guidopia.com
# SUPER_ADMIN_PASSWORD=SuperAdmin@123
# SUPER_ADMIN_NAME=Guidopia Super Admin

